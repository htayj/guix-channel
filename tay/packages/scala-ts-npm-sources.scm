(define (record->source record)
  (let ((fields (string-tokenize record)))
    (let ((name (list-ref fields 0))
          (version (list-ref fields 1))
          (url (list-ref fields 2))
          (hash (list-ref fields 3)))
      (cons (string-append name "@" version)
            (origin
              (method url-fetch)
              (uri url)
              (file-name
               (string-append "scala-ts-"
                              (string-map (lambda (c)
                                            (if (or (char=? c #\/)
                                                    (char=? c #\@))
                                                #\- c))
                                          name)
                              "-" version ".tgz"))
              (sha256 (base32 hash)))))))

(define %scala-ts-npm-sources
  (map record->source
       (remove string-null?
               (string-split %scala-ts-npm-source-records #\newline))))
