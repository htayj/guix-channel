diff --git a/gui/frostbitepaths.h b/gui/frostbitepaths.h
new file mode 100644
index 0000000..9b00f65
--- /dev/null
+++ b/gui/frostbitepaths.h
@@ -0,0 +1,77 @@
+#ifndef FROSTBITEPATHS_H
+#define FROSTBITEPATHS_H
+
+#include <QCoreApplication>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QStandardPaths>
+#include <QString>
+
+namespace FrostbitePaths {
+
+inline QString resourceDir() {
+    const QString configured = qEnvironmentVariable("FROSTBITE_RESOURCE_DIR");
+    return configured.isEmpty() ? QCoreApplication::applicationDirPath() : configured;
+}
+
+inline QString resourceFile(const QString &name) {
+    return QDir(resourceDir()).filePath(name);
+}
+
+inline QString configDir() {
+    const QString path = QStandardPaths::writableLocation(QStandardPaths::AppConfigLocation);
+    QDir().mkpath(path);
+    return path;
+}
+
+inline QString stateDir() {
+    const QString path = QStandardPaths::writableLocation(QStandardPaths::AppLocalDataLocation);
+    QDir().mkpath(path);
+    return path;
+}
+
+inline QString configFile(const QString &name) {
+    const QString path = QDir(configDir()).filePath(name);
+    const QString defaultPath = resourceFile("config/" + name);
+    if (!QFile::exists(path) && QFile::exists(defaultPath))
+        QFile::copy(defaultPath, path);
+    return path;
+}
+
+inline bool copyDirectory(const QString &source, const QString &destination) {
+    QDir sourceDir(source);
+    if (!sourceDir.exists())
+        return false;
+
+    QDir().mkpath(destination);
+    foreach (const QFileInfo &entry,
+             sourceDir.entryInfoList(QDir::NoDotAndDotDot | QDir::AllEntries)) {
+        const QString target = QDir(destination).filePath(entry.fileName());
+        if (entry.isDir()) {
+            if (!copyDirectory(entry.absoluteFilePath(), target))
+                return false;
+        } else if (!QFile::exists(target) && !QFile::copy(entry.absoluteFilePath(), target)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+inline QString profilesDir() {
+    const QString path = QDir(stateDir()).filePath("profiles");
+    if (!QDir(path).exists())
+        copyDirectory(resourceFile("profiles"), path);
+    QDir().mkpath(path);
+    return path;
+}
+
+inline QString stateFile(const QString &name) {
+    const QString path = QDir(stateDir()).filePath(name);
+    QDir().mkpath(QFileInfo(path).dir().absolutePath());
+    return path;
+}
+
+}
+
+#endif
