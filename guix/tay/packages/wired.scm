(define wired-cargo-inputs
  (map (lambda (record) (apply wired-crate-source record))
       (append %wired-cargo-records-1
               %wired-cargo-records-2
               %wired-cargo-records-3
               %wired-cargo-records-4)))

(define-public wired
  (package
    (name "wired")
    (version "0.10.7")
    (source (package-source toqozz-wired-notify-source))
    (build-system cargo-build-system)
    (arguments
     (list
      #:rust rust
      #:install-source? #f
      #:cargo-build-flags ''("--release" "--locked")
      #:cargo-test-flags ''("--locked")
      #:phases
      #~(modify-phases %standard-phases
          (add-after 'unpack 'save-reviewed-cargo-lock
            (lambda _
              ;; cargo-build-system removes Cargo.lock while it prepares the
              ;; source replacement.  Retain the exact reviewed graph until
              ;; the local vendor manifests exist.
              (copy-file "Cargo.lock" ".guix-Cargo.lock")))
          (add-after 'check-for-pregenerated-files
              'restore-locked-offline-cargo-graph
            (lambda _
              (use-modules (guix build cargo-utils))
              (setenv "CARGO_NET_OFFLINE" "true")
              (generate-all-checksums "guix-vendor")
              (copy-file ".guix-Cargo.lock" "Cargo.lock")
              ;; Registry checksums apply to downloaded archives.  The exact
              ;; archives are now local Guix vendor sources instead.
              (substitute* "Cargo.lock" (("^checksum = .*$") ""))))
          ;; The generic installer does not pass --locked.  Install only the
          ;; daemon from the restored lockfile and offline vendor tree.
          (delete 'install)
          (add-after 'check 'install-wired
            (lambda* (#:key outputs #:allow-other-keys)
              (invoke "cargo" "install" "--offline" "--locked" "--no-track"
                      "--path" "." "--bin" "wired"
                      "--root" (assoc-ref outputs "out"))))
          (add-after 'install-wired 'install-user-managed-data
            (lambda* (#:key outputs #:allow-other-keys)
              (let* ((out (assoc-ref outputs "out"))
                     (doc (string-append out "/share/doc/wired"))
                     (examples (string-append out "/share/wired/examples"))
                     (service (string-append out "/lib/systemd/user"))
                     (service-file (string-append service "/wired.service")))
                ;; The upstream MIT license also covers the declarative
                ;; examples, which contain no executable downloads or media.
                (mkdir-p doc)
                (install-file "LICENSE" doc)
                (mkdir-p examples)
                (for-each (lambda (file) (install-file file examples))
                          '("wired.ron" "wired_multilayout.ron"))
                ;; Do not enable the user-managed service during installation.
                (mkdir-p service)
                (copy-file "wired.service" service-file)
                (substitute* service-file
                  (("ExecStart=/usr/bin/wired")
                   (string-append "ExecStart=" out "/bin/wired"))))))
          (add-after 'install-user-managed-data 'wrap-xdg-open
            (lambda _
              ;; URL actions are optional, but when configured Wired invokes
              ;; xdg-open.  xkbcommon-dl likewise loads the X11 helper with
              ;; dlopen, so make that library's immutable location explicit.
              (wrap-program (string-append #$output "/bin/wired")
                `("PATH" prefix (,(string-append #$xdg-utils "/bin")))
                `("LD_LIBRARY_PATH" prefix
                  (,(string-append #$libxkbcommon "/lib")))))))))
    (native-inputs (list pkg-config))
    ;; winit is forced onto its X11 backend by upstream.  Wayland is therefore
    ;; not a supported runtime even though platform-only Rust crates are
    ;; present in the locked source closure.
    (inputs
     (append (list bash-minimal cairo pango glib dbus libx11 libxscrnsaver libxi libxrandr
                   libxcursor libxkbcommon xdg-utils)
             wired-cargo-inputs))
    (synopsis "Flexible notification daemon for X11 and XWayland")
    (description
     "Wired is a configurable notification daemon.  It provides the
@code{org.freedesktop.Notifications} session D-Bus service and renders
notifications using an X11 event loop, so it requires an X11 or XWayland
@env{DISPLAY} and a session D-Bus; it does not provide native Wayland support.
The package builds the exact upstream commit and complete Cargo.lock graph
offline from immutable source archives.  It installs only the daemon, MIT
notice, declarative configuration examples, and user-managed systemd data.
Icon and font discovery remain user or system configuration, and URL actions
use the explicit @command{xdg-open} runtime input without downloading assets.")
    (home-page "https://github.com/Toqozz/wired-notify")
    (license license:expat)))
