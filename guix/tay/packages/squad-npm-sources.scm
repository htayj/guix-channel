;; The npm tarballs omit these required MIT license texts.  Copilot SDK's
;; npm 1.0.9 provenance attestation names commit
;; cc8c7f28ea9f1894fe91a2cf161e2e6f8a52ff51, and its subject SHA-512 matches
;; the downloaded archive.  Yoga's v3.2.1 release tag resolves to
;; 042f5013152eb81c1552dec945b88f7b95ca350f; javascript/package.json at that
;; revision confirms version 3.2.1.  Neither origin follows a moving branch.
(define %squad-extra-notices
  (list
   (cons "node_modules/@github/copilot-sdk/LICENSE"
         (origin
           (method url-fetch)
           (uri "https://raw.githubusercontent.com/github/copilot-sdk/cc8c7f28ea9f1894fe91a2cf161e2e6f8a52ff51/LICENSE")
           (file-name "copilot-sdk-1.0.9-LICENSE")
           (sha256
            (base32 "1xrlnlg9qp9jnznmh9k4wlh1wqw8rlh5s1sk4iqgj30zpi3b8415"))))
   (cons "node_modules/yoga-layout/LICENSE"
         (origin
           (method url-fetch)
           (uri "https://raw.githubusercontent.com/react/yoga/042f5013152eb81c1552dec945b88f7b95ca350f/LICENSE")
           (file-name "yoga-layout-3.2.1-LICENSE")
           (sha256
            (base32 "11gw5g7whsqjfs8zjmwgqnrrq2lyhawarflbcbm5fhffqxxjshaj"))))))
