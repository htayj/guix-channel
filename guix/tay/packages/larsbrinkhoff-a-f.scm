(define (define-larsbrinkhoff-source-snapshot spec)

  (let ((symbol (string->symbol (car spec))))
    (module-define! (current-module) symbol
                    (apply make-github-source-snapshot spec))
    (module-export! (current-module) (list symbol))))
(for-each define-larsbrinkhoff-source-snapshot

          %larsbrinkhoff-a-f-snapshots)
