(define (crate-source entry)
  (let ((name (list-ref entry 0))
        (version (list-ref entry 1))
        (hash (list-ref entry 2)))
    (origin
      (method url-fetch)
      (uri (string-append "https://static.crates.io/crates/" name "/"
                          name "-" version ".crate"))
      (file-name (string-append "rust-" name "-" version ".tar.gz"))
      (sha256 (base32 hash))
      (modules '((guix build utils)))
      ;; These Windows test fixtures are the only opaque native payloads in
      ;; the complete locked closure; neither is built or installed here.
      (snippet (and (string=? name "libloading")
                    '(begin
                       (delete-file "tests/nagisa32.dll")
                       (delete-file "tests/nagisa64.dll")))))))

