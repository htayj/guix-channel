+def _run_xelatex(arguments):
+    result = run(arguments, stdout=PIPE, stderr=STDOUT, text=True)
+    if result.returncode:
+        sys.stderr.write(result.stdout)
+        for log in sorted(Path(output_directory).glob('*.log')):
+            sys.stderr.write('\n--- ' + str(log) + ' ---\n')
+            sys.stderr.write(log.read_text(encoding='utf-8', errors='replace'))
+        result.check_returncode()
 
 
