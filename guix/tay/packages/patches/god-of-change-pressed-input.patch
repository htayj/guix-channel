+      TCODSystem::waitForEvent(TCOD_EVENT_KEY_PRESS,&key,NULL,true);
       if (key.vk == TCODK_UP || key.vk == TCODK_KP8 || key.c == 'k') {
          if (curY > 0) {
             if (distance(player.x, player.y, curX, curY-1) <= maxRange) {
@@ -2429,9 +2431,11 @@
