+// Adapted from Qt's wc2rx, Copyright (C) 2016 The Qt Company Ltd.
+// Original license: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only
+// OR GPL-3.0-only. Source: qt5compat/src/core5/text/qregexp.cpp (Qt 6.6).
+// Convert Natron's legacy wildcard syntax, not filepath globbing: '*' and '?'
+// also match separators. Callers choose anchoring and enable dot-all matching.
+// unixEscaping distinguishes the former WildcardUnix and Wildcard modes.
+inline QString
+wildcardToRegularExpression(const QString& wildcard, bool unixEscaping = false)
+{
+    QString pattern;
+    pattern.reserve(wildcard.size());
+    bool escaping = false;
+    for (int i = 0; i < wildcard.size(); ++i) {
+        const QChar c = wildcard.at(i);
+        switch (c.unicode()) {
+        case '\\':
+            if (!unixEscaping || escaping) {
+                pattern += QLatin1String("\\\\");
+            }
+            if (unixEscaping && i + 1 == wildcard.size()) {
+                pattern += QLatin1String("\\\\");
+            }
+            escaping = true;
+            break;
+        case '*':
+        case '?':
+            if (escaping) {
+                pattern += QLatin1Char('\\');
+                pattern += c;
+                escaping = false;
+            } else {
+                pattern += QLatin1Char('.');
+                if (c == QLatin1Char('*')) {
+                    pattern += QLatin1Char('*');
+                }
+            }
+            break;
+        case '[':
+            if (escaping) {
+                pattern += QLatin1String("\\[");
+                escaping = false;
+            } else {
+                pattern += c;
+                if (i + 1 < wildcard.size() && wildcard.at(i + 1) == QLatin1Char('^')) {
+                    pattern += wildcard.at(++i);
+                }
+                if (i + 1 < wildcard.size() && wildcard.at(i + 1) == QLatin1Char(']')) {
+                    pattern += wildcard.at(++i);
+                }
+                while (i + 1 < wildcard.size() && wildcard.at(i + 1) != QLatin1Char(']')) {
+                    const QChar member = wildcard.at(++i);
+                    if (member == QLatin1Char('\\')) {
+                        pattern += QLatin1Char('\\');
+                    }
+                    pattern += member;
+                }
+            }
+            break;
+        case ']':
+            if (escaping) {
+                pattern += QLatin1Char('\\');
+                escaping = false;
+            }
+            pattern += c;
+            break;
+        case '$':
+        case '(':
+        case ')':
+        case '+':
+        case '.':
+        case '^':
+        case '{':
+        case '|':
+        case '}':
+            if (escaping) {
+                pattern += QLatin1String("\\\\");
+                escaping = false;
+            }
+            pattern += QLatin1Char('\\');
+            pattern += c;
+            break;
+        default:
+            if (escaping) {
+                pattern += QLatin1String("\\\\");
+                escaping = false;
+            }
+            pattern += c;
+            break;
+        }
+    }
+    return pattern;
+}
