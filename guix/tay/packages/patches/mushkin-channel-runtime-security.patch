+void SoundManager::playMSPSound(const QString& filename, const QString& url, bool loop,
+                                double volume, qint16 buffer)
+{
+    // MSP filenames arrive from an untrusted server.  This protocol accepts
+    // a filename, not a relative path: reject path separators, dot paths, and
+    // other names whose basename differs before constructing either a cache
+    // path or a download URL.
+    const QString safeFilename = QFileInfo(filename).fileName();
+    if (safeFilename.isEmpty() || safeFilename == "." || safeFilename == ".." ||
+        safeFilename != filename) {
+        qWarning() << "MSP: refusing unsafe sound filename:" << filename;
+        return;
+    }
+
+    // First, try to resolve the file locally
+    QString fullPath = resolveFilePath(safeFilename);

