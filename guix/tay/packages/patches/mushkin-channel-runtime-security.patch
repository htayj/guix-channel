+QString getAppDirectory()
+{
+    // A package installation is read-only.  Keep worlds, profiles, plugins,
+    // logs, downloaded MSP media, and the compatibility SQLite database in a
+    // per-user directory.  MUSHKIN_HOME is useful for portable installs and
+    // tests; otherwise follow XDG's data location.
+    QString path = qEnvironmentVariable("MUSHKIN_HOME");
+    if (path.isEmpty())
+        path = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    if (path.isEmpty())
+        path = QDir::home().filePath(".local/share/mushkin");
+
+    QDir().mkpath(path);
+    return QDir(path).absolutePath();
+}
+
+QString getRuntimeDirectory()
+{
+    return QCoreApplication::applicationDirPath();
+}

