+TEST_F(TelnetParserTest, MSP_PathTraversalFilenameRejected)
+{
+    QTemporaryDir temporary;
+    ASSERT_TRUE(temporary.isValid());
+    const QString oldDirectory = QDir::currentPath();
+    ASSERT_TRUE(QDir::setCurrent(temporary.path()));
+
+    QTcpServer server;
+    ASSERT_TRUE(server.listen(QHostAddress::LocalHost));
+    bool requested = false;
+    QObject::connect(&server, &QTcpServer::newConnection, [&] { requested = true; });
+
+    const QString escaped = QDir(temporary.path()).filePath("escaped.wav");
+    doc->PlayMSPSound("../../escaped.wav",
+                      QString("http://127.0.0.1:%1").arg(server.serverPort()), false, 0.0, 0);
+
+    QElapsedTimer timer;
+    timer.start();
+    while (timer.elapsed() < 250) {
+        QCoreApplication::processEvents();
+    }
+    EXPECT_FALSE(requested);
+    EXPECT_FALSE(QFile::exists(escaped));
+    EXPECT_TRUE(QDir::setCurrent(oldDirectory));
+}
