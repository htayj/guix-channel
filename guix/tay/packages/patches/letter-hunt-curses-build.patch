diff -r a/src/linuxport/Makefile b/src/linuxport/Makefile
--- a/src/linuxport/Makefile
+++ b/src/linuxport/Makefile
@@ -1,9 +1,15 @@
+# Curses-only build.  The SDL port and its screen-captured alphabet*.bmp
+# fonts are not built or installed.
 TARGET = letterhunt
 
+CXX = g++
+CXXFLAGS = -O3
+LETTERHUNT_DATADIR = ..
+ENUMMAKER = support/enummaker/enummaker
+
 OFILES = linuxport.o \
 	 ../gfxengine.o \
 	 ../gfx_curses.o \
-	 ../gfx_sdl.o \
 	 ../grammar.o \
 	 ../hiscore.o \
 	 ../item.o \
@@ -21,12 +27,12 @@
 	 ../glbdef.o
 
 .cpp.o:
-	g++ -O3 `sdl-config --cflags` -c $< -o $@
+	$(CXX) $(CXXFLAGS) -DUSE_CURSES '-DLETTERHUNT_DATADIR="$(LETTERHUNT_DATADIR)"' -c $< -o $@
 
 all: $(TARGET)
 
 $(TARGET): $(OFILES)
-	g++ -O3 -o $(TARGET) $(OFILES) `sdl-config --libs` -lcurses
+	$(CXX) $(CXXFLAGS) -o $(TARGET) $(OFILES) -lncurses
 
 clean:
 	rm -f *.o
@@ -34,4 +40,4 @@
 	rm -f $(TARGET)
 
 premake:
-	cd .. ; ./support/enummaker/enummaker source.txt
+	cd .. && $(ENUMMAKER) source.txt
