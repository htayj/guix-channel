+func readMarionetteFrame(reader *bufio.Reader) ([]byte, error) {
+	length := 0
+	digits := 0
+	for {
+		character, err := reader.ReadByte()
+		if err != nil {
+			return nil, err
+		}
+		if character == ':' {
+			break
+		}
+		if character < '0' || character > '9' || digits == 8 {
+			return nil, fmt.Errorf("Invalid Marionette frame length")
+		}
+		length = length*10 + int(character-'0')
+		digits++
+	}
+	if digits == 0 || length == 0 || length > 16*1024*1024 {
+		return nil, fmt.Errorf("Marionette frame length out of bounds: %d", length)
+	}
+	payload := make([]byte, length)
+	_, err := io.ReadFull(reader, payload)
+	return payload, err
 }
 
