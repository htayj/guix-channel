+/* Modified 2026-10-09: advance the RLE byte cursor without a cast lvalue. */
 // rle.c
 /// @file
 /// @brief Code for run-length-encoding compression.
@@ -342,7 +343,9 @@
 //{{{
 static unsigned char _rleread_ptr(void)
 {
-	return *( ((const unsigned char*)_rlepos) ++);
+	unsigned char value = *(const unsigned char*)_rlepos;
+	_rlepos = (const unsigned char*)_rlepos + 1;
