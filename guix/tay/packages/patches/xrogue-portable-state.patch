diff --git a/main.c b/main.c
index a685c11..6bd7fdd 100644
--- a/main.c
+++ b/main.c
@@ -29,6 +29,7 @@ char **argv;
 char **envp;
 {
     register char *env;
+    const char *what;
     time_t now;
 
     md_init();
@@ -37,7 +38,26 @@ char **envp;
      * get home and options from environment
      */
 
-    strncpy(home, md_gethomedir(), LINELEN);
+    /*
+     * The save file name is this directory followed by "xrogue.sav", and the
+     * score file name is ROGUEHOME followed by "/xrogue.scr"; both are held
+     * in LINELEN-byte buffers.  Refuse a directory whose file names would not
+     * fit instead of overflowing the buffers or truncating the directory,
+     * which would split the save and score locations.
+     */
+    what = "ROGUEHOME";
+    if ((env = getenv("ROGUEHOME")) == NULL || *env == '\0') {
+        what = "the home directory";
+        env = md_gethomedir();
+    }
+    if (strlen(env) + sizeof("/xrogue.sav") > LINELEN) {
+        fprintf(stderr, "xrogue: %s is too long (at most %d bytes)\n",
+                what, (int) (LINELEN - sizeof("/xrogue.sav")));
+        exit(1);
+    }
+    strcpy(home, env);
+    if (*home && home[strlen(home) - 1] != '/')
+        strcat(home, "/");
 
     /* Get default save file */
     strcpy(file_name, home);
