+#ifdef EXTERNAL_COMPRESSOR
+#include <errno.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static void run_compressor(const char *filename, int decompress)
+{
+	pid_t child, result;
+	int status;
+
+	child = fork();
+	if(child < 0)
+		panic("Couldn't start save compressor.");
+	if(child == 0)
+	{
+		if(decompress)
+			execl(EXTERNAL_COMPRESSOR, EXTERNAL_COMPRESSOR,
+			      "-f", "-q", "-d", "--", filename, (char*)NULL);
+		else
+			execl(EXTERNAL_COMPRESSOR, EXTERNAL_COMPRESSOR,
+			      "-f", "-q", "--", filename, (char*)NULL);
+		_exit(127);
+	}
+	do {
+		result = waitpid(child, &status, 0);
+	} while(result < 0 && errno == EINTR);
+	if(result < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0)
+		panic("Save compressor failed.");
+}
+#endif
