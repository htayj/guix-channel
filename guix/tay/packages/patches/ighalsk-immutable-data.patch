-sys.path.extend(["Common", "Model", "View", "Controller"])
+dataPath = os.path.dirname(os.path.abspath(__file__)) + os.sep
+sys.path.extend([os.path.join(dataPath, directory)
+                 for directory in ("Common", "Model", "View", "Controller")])
 
 import IghalskModel
 import ViewerFactory
