--- a/src/caelestia/utils/version.py
+++ b/src/caelestia/utils/version.py
@@ -1,3 +1,4 @@
+import os
 import shutil
 import subprocess
 import sys
@@ -110,6 +111,21 @@ def print_dots_version() -> None:
     )
 
 
+def _shell_version_helper() -> str:
+    """Locate the version helper installed beside the caelestia-shell launcher."""
+
+    lib_dir = os.environ.get("CAELESTIA_LIB_DIR")
+    if lib_dir:
+        return os.path.join(lib_dir, "version")
+
+    shell = shutil.which("caelestia-shell")
+    if shell is None:
+        return "/usr/lib/caelestia/version"
+
+    prefix = os.path.dirname(os.path.dirname(os.path.realpath(shell)))
+    return os.path.join(prefix, "lib", "caelestia", "version")
+
+
