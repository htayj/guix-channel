Preserve interpreter prefixes when using an unbundled Python installation.

Py_GetPythonHome may be null when Python discovers its own installation.  Do
not pass that null pointer to PyUnicode_FromWideChar or replace the prefixes
that Python has already determined.  Keep the bundled-home workaround for
Py_SetPath and share its one string object between the two assignments.
Select the actual compiled PySide major version for QtPy consumers.

Natron embeds the full Python API rather than building an abi3 module.  Remove
only Py_LIMITED_API from the imported Shiboken target's interface definitions,
leaving its other flags and imported abi3 binaries, headers, and links intact.
Remove the redundant source-level overrides so all consumers use this policy.

Upstream: source runtime fixes for pinned 3763d805d7d277d10af10025ae41af677682b3e6.

--- a/Global/PythonUtils.cpp
+++ b/Global/PythonUtils.cpp
@@ -21,5 +21,4 @@
 // from <https://docs.python.org/3/c-api/intro.html#include-files>:
 // "Since Python may define some pre-processor definitions which affect the standard headers on some systems, you must include Python.h before any standard headers are included."
-#undef Py_LIMITED_API  // Needed for Py_NoUserSiteDirectory, PyBytes_AS_STRING
 #include <Python.h>
 // ***** END PYTHON BLOCK *****
@@ -259,8 +258,11 @@
     // Py_SetPath clears sys.prefix and sys.exec_prefix
     // https://github.com/NatronGitHub/Natron/issues/696
-    PyObject *prefix = PyUnicode_FromWideChar(Py_GetPythonHome(), -1);
-    PySys_SetObject(const_cast<char*>("prefix"), prefix);
-    Py_XDECREF(prefix);
-    PyObject *exec_prefix = PyUnicode_FromWideChar(Py_GetPythonHome(), -1);
-    PySys_SetObject(const_cast<char*>("exec_prefix"), exec_prefix);
-    Py_XDECREF(exec_prefix);
+    const wchar_t* pythonHome = Py_GetPythonHome();
+    if (pythonHome) {
+        PyObject* prefix = PyUnicode_FromWideChar(pythonHome, -1);
+        if (prefix) {
+            PySys_SetObject(const_cast<char*>("prefix"), prefix);
+            PySys_SetObject(const_cast<char*>("exec_prefix"), prefix);
+            Py_DECREF(prefix);
+        }
+    }
