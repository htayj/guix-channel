+(defun batch-debugger-command ()
+  "Read a debugger command line from standard input in batch mode.
+   `read-char-exclusive' waits forever there when input is exhausted,
+   so exit Emacs with a failure status instead."
+  (let ((line (condition-case nil
+		  (read-from-minibuffer "")
+		(end-of-file
+		 (message "Debugger: end of input; exiting.")
+		 (kill-emacs 1)))))
+    (if (string= line "")
+	10
+	(aref line 0))))
+
