 (defun compile1 (form)
-  (byte-compile (compile2 form)))
+  ;; The compiler emits dynamically scoped Emacs Lisp; compile it that
+  ;; way regardless of the caller's buffer-local `lexical-binding'.
+  ;; Expand macros before `byte-compile' so that `load-time-value'
+  ;; forms in the output become constants now.  Since Emacs 24,
+  ;; `cl-load-time-value' expanded by the compiler assumes a file
+  ;; compilation and would leave an unbound `--cl-load-time--N'.
+  ;;
+  ;; When the function closes over local functions, the compiler
+  ;; returns a closure-creating form, not a lambda expression.  Emacs
+  ;; `byte-compile' only returns a function for lambda expressions, so
+  ;; compile the form and evaluate it with an empty closure environment.
+  (let ((lexical-binding nil)
+	(elisp (macroexpand-all (compile2 form))))
+    (if (eq (car-safe elisp) 'lambda)
+	(byte-compile elisp)
+	(let ((env nil))
+	  (funcall (byte-compile `(lambda () ,elisp)))))))
 
 (defun compile2 (form)
   (with-fresh-context
     (compile-form form *global-environment*)))
 
