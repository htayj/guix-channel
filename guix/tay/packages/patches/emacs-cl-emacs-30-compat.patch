 (defun EVAL (form)
-  (let ((debug-on-error t)
-	(debug-on-quit t)
-	(debug-on-signal t)
-	(debug-ignored-errors nil)
-	(debugger 'cl-debugger))
-    (eval-with-env form nil)))
+  (if (fboundp 'handler-bind)
+      ;; Emacs 29 and later: convert an Emacs error into a Common Lisp
+      ;; condition only when no Emacs handler inside this evaluation
+      ;; catches it.  Emacs signals and catches errors internally, for
+      ;; example while byte-compile displays a warning; the
+      ;; `debug-on-signal' method below would turn those into Common
+      ;; Lisp errors and enter the debugger.
+      (let ((debug-on-quit t)
+	    (debugger 'cl-debugger))
+	(handler-bind ((error (lambda (condition)
+				(cl-debugger 'error condition))))
+	  (eval-with-env form nil)))
+      (let ((debug-on-error t)
+	    (debug-on-quit t)
+	    (debug-on-signal t)
+	    (debug-ignored-errors nil)
+	    (debugger 'cl-debugger))
+	(eval-with-env form nil))))
