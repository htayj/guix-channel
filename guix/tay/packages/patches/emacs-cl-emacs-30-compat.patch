+(defun fold-bq (form)
+  "Turn a LIST or LIST* form whose arguments are all quoted into a
+   quoted constant.  Used on an inner backquote expansion before the
+   enclosing backquote uses it as a template."
+  (if (and (consp form)
+	   (memq (first form) '(LIST LIST*))
+	   (every (lambda (x) (and (consp x) (eq (first x) 'QUOTE)))
+		  (rest form)))
+      (let ((values (mapcar #'second (rest form))))
+	`(QUOTE ,(if (eq (first form) 'LIST)
+		     values
+		     (apply #'list* values))))
+      form))
+
 (defun optimize-bq (form)
   (if (and (consp form)
 	   (eq (first form) 'APPEND))
