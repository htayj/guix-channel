+namespace {
+// Preserve upstream filters: files include dotfiles; directories do not include
+// names beginning with '.'. Return entry names rather than full paths.
+list< string > ListDirectory ( string path, bool directories ) {
+	list< string > entries;
+	DIR *directory = opendir( path.c_str() );
+	if ( !directory ) {
+		g_logger->Write( LOG_LEVEL_WARN, "Failed to list directory '%s'. Error code '%d'", path.c_str(), errno );
+		return entries;
+	}
+	if ( !path.empty() && path[path.length() - 1] != '/' )
+		path += '/';
+	for ( ;; ) {
+		errno = 0;
+		struct dirent *entry = readdir( directory );
+		if ( !entry ) {
+			if ( errno )
+				g_logger->Write( LOG_LEVEL_WARN, "Failed to read directory '%s'. Error code '%d'", path.c_str(), errno );
+			break;
+		}
+		if ( directories && entry->d_name[0] == '.' )
+			continue;
+		string fullPath = path + entry->d_name;
+		struct stat info;
+		if ( lstat( fullPath.c_str(), &info ) != 0 ) {
+			g_logger->Write( LOG_LEVEL_WARN, "Failed to inspect '%s'. Error code '%d'", fullPath.c_str(), errno );
+			continue;
+		}
+		// Follow links for listing only; dangling links remain removable files.
+		if ( S_ISLNK( info.st_mode ) ) {
+			struct stat target;
+			if ( stat( fullPath.c_str(), &target ) == 0 )
+				info = target;
+		}
+		if ( (S_ISDIR( info.st_mode ) != 0) == directories )
+			entries.push_back( entry->d_name );
+	}
+	if ( closedir( directory ) != 0 )
+		g_logger->Write( LOG_LEVEL_WARN, "Failed to close directory '%s'. Error code '%d'", path.c_str(), errno );
+	return entries;
+}
