+// SDL keycodes are sparse and must not index the old 256-entry VK table.
+// Like upstream, only Shift modifies ASCII: Caps Lock and Control do not.
+inline int MapKey ( SDL_Keycode key, bool shift ) {
+    if ( key >= SDLK_a && key <= SDLK_z )
+        return (shift ? 'A' : 'a') + (key - SDLK_a);
+    if ( key >= SDLK_0 && key <= SDLK_9 ) {
+        const char shifted[] = ")!@#$%^&*(";
