(define (crate-source entry)
  (let ((name (list-ref entry 0))
        (version (list-ref entry 1)))
    (origin
      (method url-fetch)
      (uri (string-append "https://static.crates.io/crates/" name "/"
                          name "-" version ".crate"))
      (file-name (string-append "rust-" name "-" version ".tar.gz"))
      (sha256 (base32 (list-ref entry 2))))))

(define %autolith-fff-cargo-inputs
  (map crate-source %autolith-fff-locked-crates))

