(define %yoga-ink-npm-fields
  (map (lambda (line) (string-split line #\tab))
       (remove string-null? (string-split %yoga-ink-npm-records #\newline))))

(define (record-key fields)
  (string-append (list-ref fields 0) "@" (list-ref fields 1)))

(define %yoga-ink-npm-sources
  (map (lambda (fields)
         (cons (record-key fields)
               (origin
                 (method url-fetch)
                 (uri (list-ref fields 2))
                 (file-name
                  (string-append "yoga-ink-"
                                 (string-map (lambda (character)
                                               (if (memv character '(#\@ #\/))
                                                   #\- character))
                                             (list-ref fields 0))
                                 "-" (list-ref fields 1) ".tgz"))
                 (sha256 (base32 (list-ref fields 3))))))
       %yoga-ink-npm-fields))

;; MANIFEST rows for yoga-ink-npm.py are location<TAB>key<TAB>store-archive.
;; Resolve each layout key through %yoga-ink-npm-sources/native inputs.
(define %yoga-ink-npm-layout
  (map (lambda (fields)
         (cons (string-append "node_modules/" (list-ref fields 0))
               (record-key fields)))
       %yoga-ink-npm-fields))

(define yoga-ink-npm-inputs %yoga-ink-npm-sources)

;; No fabricated or generic replacement notices: all 142 archives carry their
;; authoritative upstream license texts, including caniuse-lite's CC-BY-4.0.
(define %yoga-ink-npm-license-supplements '())
