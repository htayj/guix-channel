(define (npm-origin record)
  (match record
    ((name version uri integrity license)
     (cons (string-append name "@" version)
           (origin
             (method url-fetch)
             (uri uri)
             (file-name
              (string-append
               "hermes-desktop-"
               (string-map (lambda (c)
                             (if (or (char=? c #\/) (char=? c #\@))
                                 #\- c))
                           name)
               "-" version ".tgz"))
             (hash (content-hash (base64-decode integrity) sha512))
             (modules '((guix build utils)))
             (snippet
              (and (string=? name "@nous-research/ui")
                   '(begin
                      (use-modules (guix build utils))
                      ;; Upstream npm includes these fonts without grants.
                      ;; Preserve CSS aliases for the free-font replacement.
                      (for-each delete-file
                                (find-files "." "\\.(ttf|otf|woff2?|eot)$"))
                      #t))))))))

(define %hermes-desktop-npm-sources
  (map npm-origin %hermes-desktop-npm-records))

(define %hermes-desktop-ui-source
  (assoc-ref %hermes-desktop-npm-sources "@nous-research/ui@0.18.2"))

(define %hermes-desktop-npm-licenses
  (map (lambda (record)
         (match record
           ((name version uri integrity license)
            (cons (string-append name "@" version) license))))
       %hermes-desktop-npm-records))
