(define (npm-origin record)
  (match record
    ((key name version uri integrity hash license declared-license)
     (cons key
           (origin
             (method url-fetch)
             (uri uri)
             (file-name
              (string-append "oh-my-opencode-slim-"
                             (string-map (lambda (character)
                                           (if (or (char=? character #\/)
                                                   (char=? character #\@))
                                               #\- character))
                                         key)
                             "-" version ".tgz"))
             (hash (content-hash (nix-base32-string->bytevector hash)
                                 sha256)))))))

(define %oh-my-opencode-slim-npm-sources
  (map npm-origin %oh-my-opencode-slim-npm-source-records))
