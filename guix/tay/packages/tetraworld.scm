    (method url-fetch)
    (uri "https://codeload.github.com/adamdruppe/arsd/tar.gz/d5c35392931925ca75fe3a399de6c254b57673b0")
    (file-name "tetraworld-arsd-d5c3539.tar.gz")
    (sha256
     (base32 "0kkmkdlgdxmx0qad6s1az3mwllpalm836973xraqq3i1h2xp1p8c"))))

