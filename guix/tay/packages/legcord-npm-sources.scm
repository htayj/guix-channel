(define (npm-origin record)
  (match record
    ((key uri integrity license)
     (cons key
           (origin
             (method url-fetch)
             (uri uri)
             (file-name
              (string-append
               "legcord-"
               (string-map (lambda (c)
                             (if (or (char=? c #\/) (char=? c #\@)
                                     (char=? c #\:))
                                 #\- c))
                           key)
               ".tgz"))
             (hash (content-hash (base64-decode integrity) sha512)))))))

