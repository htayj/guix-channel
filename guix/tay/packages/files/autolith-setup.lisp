;;; Qlot's small loading interface, backed entirely by the Guix closure.
(require :asdf)
(let* ((root (uiop:ensure-directory-pathname
              (or (uiop:getenv "AUTOLITH_GUIX_CONFIG_ROOT")
                  (error "Autolith needs its Guix launcher environment."))))
       (source (uiop:ensure-directory-pathname
                (or (uiop:getenv "AUTOLITH_NIX_SOURCE_ROOT")
                    (error "Autolith source root is not set."))))
       (cache (uiop:ensure-directory-pathname
               (or (uiop:getenv "AUTOLITH_ASDF_CACHE")
                   (error "Autolith's writable ASDF cache is not set.")))))
  (asdf:initialize-source-registry
   `(:source-registry
     (:include ,(namestring
                 (merge-pathnames "source-registry.conf.d/" root)))
     :ignore-inherited-configuration))
  ;; Only Autolith's own FASLs are mutable.  Every dependency retains the
  ;; exact source/FASL mapping generated by Guix for this SBCL version.
  (asdf:initialize-output-translations
   `(:output-translations
     ((,source :**/ :*.*.*) (,cache :**/ :*.*.*))
     (:include ,(namestring
                 (merge-pathnames "asdf-output-translations.conf.d/" root)))
     :ignore-inherited-configuration)))
(defpackage #:ql
  (:use #:cl)
  (:export #:quickload))
(in-package #:ql)
(defun quickload (system &key silent &allow-other-keys)
  (declare (ignore silent))
  (asdf:load-system system))
