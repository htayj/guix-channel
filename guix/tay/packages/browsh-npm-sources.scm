;; Exported records: node_modules path, name, version, origin, integrity,
;; license label.  Repeated locations retain the exact upstream nesting.
(define %browsh-npm-sources
  (map
   (lambda (record)
     (let ((name (list-ref record 1))
           (version (list-ref record 2))
           (integrity (list-ref record 4)))
       (list
        (car record) name version
        (origin
          (method url-fetch)
          (uri (list-ref record 3))
          (file-name
           (string-append
            "browsh-npm-"
            (string-map (lambda (c)
                          (if (or (char=? c #\/) (char=? c #\@)) #\- c))
                        name)
            "-" version ".tgz"))
          (hash (content-hash
                 (base64-decode (substring integrity 7)) sha512)))
        integrity (list-ref record 5))))
   %browsh-npm-records))
