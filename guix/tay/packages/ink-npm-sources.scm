(define %ink-npm-sources
  (map (match-lambda
         ((path name version uri integrity license)
          (cons path
                (origin
                  (method url-fetch)
                  (uri uri)
                  (file-name (string-append "ink-"
                                           (string-map (lambda (c)
                                                         (if (or (char=? c #\/)
                                                                 (char=? c #\@))
                                                             #\- c))
                                                       name)
                                           "-" version ".tgz"))
                  (hash (content-hash (base64-decode integrity) sha512))))))
       %ink-npm-records))

;; React and its declaration dependency are siblings so a consumer and Ink
;; resolve one React instance, never a second private copy.
